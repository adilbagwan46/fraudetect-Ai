# Fraudetect AI local configuration. Copy to .env and keep .env private.
FRAUDETECT_ENV=development
FRAUDETECT_API_PREFIX=/api/v1
FRAUDETECT_DATASET_MANIFEST=data/processed/manifest.json
FRAUDETECT_MODEL_ARTIFACT_ROOT=artifacts/models
FRAUDETECT_BEHAVIORAL_HISTORY_DB=artifacts/behavioral/history.sqlite
FRAUDETECT_RELATIONSHIP_HISTORY_DB=artifacts/relationship/history.sqlite
FRAUDETECT_CASE_DATABASE=artifacts/cases/cases.sqlite

# Disabled by default: the deterministic fallback requires no credentials.
FRAUDETECT_LLM_ENABLED=false
FRAUDETECT_LLM_PROVIDER=openai
FRAUDETECT_LLM_MODEL=gpt-5.6
FRAUDETECT_LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=

# Alternative real provider (set FRAUDETECT_LLM_PROVIDER=gemini explicitly).
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=
